---
import { getPrimaryNavigation } from '../config/navigation';
import { siteConfig } from '../config/site';

const base = import.meta.env.BASE_URL;
const links = getPrimaryNavigation(base);
const isContactPage = Astro.url.pathname === `${base}contacto/`;
---

<footer class="site-footer">
  {!isContactPage && (
    <div class="site-footer__contact">
      <p>Contacto</p>
      <h2>Revisemos el alcance técnico de su proyecto.</h2>
      <p>
        Describa brevemente el estudio o diseño que necesita. La consulta será atendida por los
        profesionales responsables.
      </p>
      <a class="footer-action" href={`${base}contacto/`}>
        Consultar un proyecto
      </a>
      <a class="footer-email" href={`mailto:${siteConfig.contactEmail}`}>
        {siteConfig.contactEmail}
      </a>
    </div>
  )}

  <div class="site-footer__map">
    <div>
      <strong>Aquatek</strong>
      <span>{siteConfig.tagline}</span>
    </div>
    <nav aria-label="Navegación del pie de página">
      {links.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
    </nav>
  </div>

  <div class="site-footer__legal">
    <span>Sitio técnico de Aquatek</span>
    <a href={base}>Volver al inicio</a>
  </div>
</footer>

<style>
  .site-footer {
    color: var(--color-white);
    background: var(--color-navy);
  }

  .site-footer__contact,
  .site-footer__map,
  .site-footer__legal {
    width: min(100%, var(--content-width));
    margin-inline: auto;
    padding-inline: var(--page-gutter);
  }

  .site-footer__contact {
    display: grid;
    gap: 1rem;
    padding-block: clamp(4rem, 8vw, 7rem);
  }

  .site-footer__contact > p:first-child {
    color: #b8c4f2;
    font-weight: 700;
  }

  .site-footer__contact h2 {
    max-width: 15ch;
    color: inherit;
  }

  .site-footer__contact p {
    max-width: 38rem;
    margin-bottom: 0;
    color: var(--color-on-dark);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .footer-action {
    width: fit-content;
    align-self: start;
    padding-bottom: 0.3rem;
    border-bottom: 2px solid var(--color-indigo-soft);
    font-weight: 700;
    text-decoration: none;
  }

  .footer-email {
    width: fit-content;
    color: var(--color-on-dark);
    font-weight: 650;
    text-underline-offset: 0.3rem;
  }

  .site-footer__map {
    display: grid;
    gap: 2rem;
    padding-block: 2.5rem;
    border-top: 1px solid rgb(255 255 255 / 22%);
  }

  .site-footer__map > div {
    display: grid;
    gap: 0.35rem;
  }

  .site-footer__map strong {
    font-family: var(--font-display);
    font-size: 1.4rem;
  }

  .site-footer__map span,
  .site-footer__legal {
    color: var(--color-on-dark-muted);
  }

  .site-footer nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem 1.5rem;
  }

  .site-footer nav a,
  .site-footer__legal a {
    text-underline-offset: 0.3rem;
  }

  .site-footer__legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-block: 1.4rem;
    border-top: 1px solid rgb(255 255 255 / 14%);
    font-size: 0.9rem;
  }

  @media (min-width: 48rem) {
    .site-footer__contact,
    .site-footer__map {
      grid-template-columns: minmax(16rem, 0.8fr) minmax(20rem, 1.2fr);
      align-items: start;
    }

    .site-footer__contact > p:first-child {
      grid-column: 1 / -1;
    }

    .site-footer nav {
      grid-template-columns: repeat(4, auto);
      justify-content: end;
    }
  }
</style>
