---
import type { CollectionEntry } from 'astro:content';
import { disciplineLabels } from '../utils/disciplines';

type Props = {
  project: CollectionEntry<'projects'>;
};

const { project } = Astro.props;
const base = import.meta.env.BASE_URL;
const coverMedium =
  project.data.media.find((medium) => medium.type === 'video' && medium.poster) ??
  project.data.media.find((medium) => medium.type === 'image');
const cover = coverMedium?.type === 'video' ? coverMedium.poster : coverMedium?.src;
---

<header class="project-hero">
  <nav aria-label="Ruta de navegación">
    <a href={base}>Inicio</a>
    <span aria-hidden="true">/</span>
    <a href={`${base}proyectos/`}>Proyectos</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{project.data.title}</span>
  </nav>

  <div class="project-hero__body">
    <div class="project-hero__copy">
      <p>Proyecto de Ingeniería de Recursos Hídricos</p>
      <h1>{project.data.headline ?? project.data.title}</h1>
      <p class="project-hero__summary">{project.data.summary}</p>
      <dl>
        <div>
          <dt>Lugar</dt>
          <dd>{project.data.location ?? 'Ubicación reservada'}</dd>
        </div>
        {project.data.year && (
          <div>
            <dt>Año</dt>
            <dd>{project.data.year}</dd>
          </div>
        )}
        <div>
          <dt>Especialidad</dt>
          <dd>{disciplineLabels[project.data.discipline]}</dd>
        </div>
      </dl>
    </div>
    {cover && (
      <figure>
        <img
          src={`${base}${cover.replace(/^\//, '')}`}
          alt={coverMedium?.alt ?? `Portada técnica de ${project.data.title}`}
          width="1600"
          height="900"
          fetchpriority="high"
          draggable="false"
        />
        <figcaption>
          {coverMedium?.caption ?? 'Portada del caso con evidencia técnica revisada.'}
        </figcaption>
      </figure>
    )}
  </div>
</header>

<style>
  .project-hero {
    width: min(100%, var(--content-width));
    margin-inline: auto;
    border-bottom: 1px solid var(--color-line);
  }

  .project-hero > nav {
    display: flex;
    gap: 0.55rem;
    padding: 1.5rem var(--page-gutter);
    color: var(--color-blue);
    font-size: 0.92rem;
  }

  .project-hero > nav a {
    text-underline-offset: 0.25rem;
  }

  .project-hero__body {
    display: grid;
  }

  .project-hero__copy {
    align-content: center;
    padding: clamp(2.5rem, 5vw, 4.25rem) var(--page-gutter);
  }

  .project-hero__copy > p:first-child {
    width: fit-content;
    margin-bottom: 1.15rem;
    padding-bottom: 0.35rem;
    border-bottom: 2px solid var(--color-signal);
    color: var(--color-blue);
    font-weight: 750;
  }

  .project-hero h1 {
    max-width: 15ch;
    font-size: clamp(2.65rem, 4vw, 4.25rem);
    line-height: 0.98;
  }

  .project-hero__summary {
    max-width: 42rem;
    font-size: clamp(1.05rem, 1.35vw, 1.2rem);
    line-height: 1.55;
  }

  .project-hero dl {
    display: grid;
    gap: 0.8rem;
    margin: 1.5rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--color-line);
  }

  .project-hero dl div {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: 1rem;
  }

  .project-hero dt {
    color: var(--color-blue);
    font-weight: 750;
  }

  .project-hero dd {
    margin: 0;
  }

  .project-hero figure {
    display: grid;
    grid-template-rows: auto auto;
    align-self: center;
    align-content: center;
    margin: 0;
    border-top: 1px solid var(--color-line);
    background: var(--color-paper);
  }

  .project-hero figure img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: contain;
    background: var(--color-ice);
    pointer-events: none;
    user-select: none;
  }

  .project-hero figcaption {
    align-self: end;
    padding: 1rem 1.25rem;
    border-top: 1px solid var(--color-line);
    color: var(--color-blue);
    font-size: 0.9rem;
  }

  @media (min-width: 64rem) {
    .project-hero__body {
      grid-template-columns: minmax(30rem, 0.95fr) minmax(32rem, 1.05fr);
      align-items: center;
    }

    .project-hero figure {
      border-top: 0;
      border-left: 1px solid var(--color-line);
    }
  }
</style>
