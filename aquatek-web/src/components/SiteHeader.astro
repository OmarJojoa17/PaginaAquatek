---
import { getContactHref, getPrimaryNavigation } from '../config/navigation';

const base = import.meta.env.BASE_URL;
const links = getPrimaryNavigation(base);
const contactHref = getContactHref(base);
const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => {
  if (href.includes('#')) return false;

  const targetPath = new URL(href, Astro.url).pathname;
  return (
    targetPath === currentPath ||
    (targetPath.endsWith('/especialidades/') && currentPath.startsWith(targetPath)) ||
    (targetPath.endsWith('/proyectos/') && currentPath.startsWith(targetPath))
  );
};
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="brand" href={base} aria-label="Aquatek, inicio">
      <img
        src={`${base}brand/logo-aquatek-recursos-hidricos.png`}
        alt="Aquatek, Ingeniería de Recursos Hídricos"
        width="395"
        height="321"
      />
    </a>

    <nav class="desktop-nav" aria-label="Navegación principal">
      {links.map((link) => (
        <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
          {link.label}
        </a>
      ))}
      <a
        class="contact-link"
        href={contactHref}
        aria-current={isCurrent(contactHref) ? 'page' : undefined}
      >
        Contacto
      </a>
    </nav>

    <details class="mobile-menu">
      <summary>
        <span>Menú</span>
        <span class="menu-icon" aria-hidden="true">
          <i></i>
          <i></i>
        </span>
      </summary>
      <nav aria-label="Navegación móvil">
        {links.map((link) => (
          <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
            {link.label}
          </a>
        ))}
        <a href={contactHref} aria-current={isCurrent(contactHref) ? 'page' : undefined}>
          Contacto
        </a>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    z-index: 20;
    top: 0;
    border-bottom: 1px solid var(--color-line);
    background: rgb(244 247 251 / 96%);
    backdrop-filter: blur(12px);
  }

  .site-header__inner {
    display: flex;
    width: min(100%, var(--content-width));
    min-height: 5.5rem;
    align-items: center;
    justify-content: space-between;
    margin-inline: auto;
    padding-inline: var(--page-gutter);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    text-decoration: none;
  }

  .brand img {
    display: block;
    width: auto;
    height: 4.15rem;
    object-fit: contain;
  }

  .desktop-nav {
    display: none;
  }

  .mobile-menu {
    position: relative;
  }

  .mobile-menu summary {
    display: flex;
    min-width: 4.8rem;
    min-height: 2.75rem;
    align-items: center;
    justify-content: space-between;
    gap: 0.65rem;
    color: var(--color-navy);
    cursor: pointer;
    font-family: var(--font-display);
    font-weight: 700;
    list-style: none;
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .menu-icon {
    display: grid;
    width: 1.25rem;
    gap: 0.35rem;
  }

  .menu-icon i {
    display: block;
    height: 2px;
    background: currentColor;
    transition: transform 180ms ease;
  }

  .mobile-menu[open] .menu-icon i:first-child {
    transform: translateY(4px) rotate(45deg);
  }

  .mobile-menu[open] .menu-icon i:last-child {
    transform: translateY(-4px) rotate(-45deg);
  }

  .mobile-menu nav {
    position: fixed;
    top: 5.5rem;
    right: 0;
    left: 0;
    display: grid;
    padding: 1rem var(--page-gutter) 1.5rem;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-paper);
    box-shadow: 0 1rem 2.5rem rgb(7 30 61 / 12%);
  }

  .mobile-menu nav a {
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--color-line);
    color: var(--color-navy);
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 650;
    text-decoration: none;
  }

  .mobile-menu nav a:last-child {
    border-bottom: 0;
    color: var(--color-blue);
  }

  @media (min-width: 64rem) {
    .mobile-menu {
      display: none;
    }

    .desktop-nav {
      display: flex;
      align-items: center;
      gap: clamp(1.1rem, 2.2vw, 2.25rem);
    }

    .desktop-nav a {
      color: var(--color-navy);
      font-weight: 650;
      text-decoration: none;
      text-underline-offset: 0.35rem;
    }

    .desktop-nav a:hover {
      color: var(--color-indigo);
      text-decoration: underline;
    }

    .desktop-nav a[aria-current='page'] {
      color: var(--color-blue);
      text-decoration: underline;
    }

    .desktop-nav .contact-link {
      padding: 0.65rem 0.9rem;
      border: 1px solid var(--color-navy);
      color: var(--color-navy);
      text-decoration: none;
    }

    .desktop-nav .contact-link:hover {
      color: var(--color-white);
      background: var(--color-navy);
      text-decoration: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-icon i {
      transition: none;
    }
  }
</style>
