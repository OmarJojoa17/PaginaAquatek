---
type Props = {
  title: string;
  description: string;
  headingId: string;
  titleLines?: string[];
};

const { title, description, headingId, titleLines } = Astro.props;
---

<div class="section-intro">
  <h2 id={headingId}>{titleLines ? titleLines.map((line) => <span>{line}</span>) : title}</h2>
  <p>{description}</p>
</div>
